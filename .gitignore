.DS_Store
.pytest_cache/
**/__pycache__/
*.py[cod]

# Local experiment outputs and packaged datasets. Runner source files such as
# run_gate2.py remain trackable because these rules match directories only.
**/run/
**/runs/
**/dataset/
**/datasets/

# Large generated/local data. Keep split manifests and selected reports tracked.
data/shared/dino/
data/v1/cache/
data/v2/cache/
data/v2/cache_*/
data/v2/dino_layers/
data/v2/*_graph_report.json
!data/v2/graph_report_all.json
!data/v2/rope_graph_report.json
!data/v2/sloth_graph_report.json

# Superseded local runs are documented under docs/v1.
archive/v1_runs/

# Keep summaries, histories and CSV diagnostics; exclude large model/video blobs.
v1/artifacts/**/*.pt
v1/artifacts/**/*.mp4
v1/artifacts/**/*.png
v1/artifacts/**/*.jpg

v1/work/
v2/runs/*
v2/artifacts/**/*.pt
v2/artifacts/**/*.mp4

v3/runs/*
v3/artifacts/**/*.pt
v3/artifacts/**/*.mp4

# V4 fixed-graph caches and model blobs are reproducible from tracked manifests.
v4/cache/
v4/runs/**/*.pt

# Material-inference experiment outputs.
material_infer/outputs/
